{
  "expo": {
    "name": "ChoreoLayer",
    "slug": "choreo-layer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.systemdesign.choreolayer",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connect to the audio analysis server on the same Wi-Fi network.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.systemdesign.choreolayer",
      "adaptiveIcon": {
        "backgroundColor": "#111114",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": false,
          "androidPermissions": [],
          "androidFSTypes": [],
          "androidFSStopWithTask": true,
          "disableFFmpeg": false,
          "disableStaticExternalLibs": false
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-video",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photo library to import practice videos.",
          "cameraPermission": "Allow camera access to record practice videos.",
          "microphonePermission": "Allow microphone access to record audio with practice videos."
        }
      ]
    ],
    "extra": {
      "defaultServerUrl": "http://10.249.26.32:8000",
      "eas": {
        "projectId": "f8029e9f-c0a6-4174-9d52-5c79aefbe138"
      }
    },
    "scheme": "choreolayer",
    "web": {
      "bundler": "metro"
    },
    "owner": "sensible_life",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f8029e9f-c0a6-4174-9d52-5c79aefbe138"
    }
  }
}
